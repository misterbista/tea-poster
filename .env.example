# Server-only OpenRouter key. Never expose this through NEXT_PUBLIC_*.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nex-agi/nex-n2.5-pro:free
OPENROUTER_FALLBACK_MODELS=openrouter/free

# Vercel Blob store token for the shared server deck.
BLOB_READ_WRITE_TOKEN=

# Secret used by Vercel Cron when calling the daily generation route.
CRON_SECRET=
