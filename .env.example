# Server-only AI Gateway key. Never expose this through NEXT_PUBLIC_*.
AI_GATEWAY_API_KEY=
AI_GATEWAY_MODEL=openai/gpt-5.4
AI_GATEWAY_FALLBACK_MODELS=anthropic/claude-haiku-4.5

# Vercel Blob store token for the shared server deck.
BLOB_READ_WRITE_TOKEN=

# Secret used by Vercel Cron when calling the daily generation route.
CRON_SECRET=
